{
  "name": "@unas/extension-demo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:extension": "wxt --browser chrome --mv3",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "node e2e/run.mjs --browser=chrome",
    "test:e2e:p3": "node e2e/run.mjs --browser=chrome --headed --color-profile=display-p3",
    "test:e2e:web": "playwright test --config playwright.web.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "build:extension": "wxt build --browser chrome --mv3",
    "zip:extension": "wxt zip --browser chrome --mv3",
    "verify": "vitest run && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.9",
    "wxt": "0.21.4"
  }
}
